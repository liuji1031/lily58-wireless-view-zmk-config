#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/*
 * Merged from the ZMK Studio export lily58-2026-08-16.keymap.
 *
 * Layers: 0 Base, 1 Lower, 2 Raise, 3 Artist, 4 Game, 5 Colemak.
 * Keys marked with * in the layout diagrams are hold-taps (&mt, tuned below):
 * TAB holds as shift+tab, SPACE holds as =, ENTER holds as _.
 *
 * The right center key cycles through every layer in order. Each layer binds
 * that position to &to <next layer>, shown as >LOWER, >RAISE, >ARTIST, >GAME
 * and >BASE in the diagrams, so repeated presses walk 0 -> 1 -> 2 -> 3 -> 4 -> 0.
 */

&mt {
    tapping-term-ms = <200>;
    require-prior-idle-ms = <100>;
    quick-tap-ms = <200>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |   1   |   2   |   3   |   4   |   5   |                   |   6   |   7   |   8   |   9   |   0   |  BSPC |
            // |  TAB* |   Q   |   W   |   E   |   R   |   T   |                   |   Y   |   U   |   I   |   O   |   P   |   "   |
            // | SHIFT |   A   |   S   |   D   |   F   |   G   |                   |   H   |   J   |   K   |   L   |   ;   |   '   |
            // |  CTRL |   Z   |   X   |   C   |   V   |   B   | BT_NXT|  | >LOWER |   N   |   M   |   ,   |   .   |   /   |   \   |
            //                         |  GUI  |  ALT  | LOWER | SPACE*|  | ENTER* | RAISE | PG_UP | PG_DN |

            display-name = "Base";
            bindings = <
&kp ESC          &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                                  &kp N6  &kp N7     &kp N8     &kp N9   &kp N0    &kp BSPC
&mt LS(TAB) TAB  &kp Q   &kp W   &kp E     &kp R     &kp T                                   &kp Y   &kp U      &kp I      &kp O    &kp P     &kp DQT
&kp LSHFT        &kp A   &kp S   &kp D     &kp F     &kp G                                   &kp H   &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL        &kp Z   &kp X   &kp C     &kp V     &kp B   &bt BT_NXT       &to 1          &kp N   &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                                 &kp LGUI  &kp LALT  &mo 1   &mt EQUAL SPACE  &mt UNDER RET  &mo 2   &kp PG_UP  &kp PG_DN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   ~   |   `   |  MUTE |  VOL+ |       |       |                   | PSCRN |       |  NUM  |   7   |   8   |   9   |
            // |  CAPS |       |       |  VOL- |   {   |   }   |                   |       |       |       |   4   |   5   |   6   |
            // | SHIFT |       |       |       |   [   |   ]   |                   |       |       |       |   1   |   2   |   3   |
            // |  CTRL |       |       |       |       |       |       |  | >RAISE |       |       |       |   0   |       |  BSPC |
            //                         |  GUI  |       |       |       |  |        |       |  HOME |  END  |

            display-name = "Lower";
            bindings = <
&kp TILDE  &kp GRAVE  &kp C_MUTE  &kp C_VOLUME_UP    &none     &none                         &kp PSCRN  &none     &kp KP_NUM  &kp KP_N7  &kp KP_N8  &kp KP_N9
&kp CAPS   &none      &none       &kp C_VOLUME_DOWN  &kp LBRC  &kp RBRC                      &none      &none     &none       &kp KP_N4  &kp KP_N5  &kp KP_N6
&kp LSHFT  &none      &none       &none              &kp LBKT  &kp RBKT                      &none      &none     &none       &kp KP_N1  &kp KP_N2  &kp KP_N3
&kp LCTRL  &none      &none       &none              &none     &none     &none    &to 2      &none      &none     &none       &kp KP_N0  &none      &kp BSPC
                                  &kp LGUI           &none     &none     &none    &none  &none      &kp HOME  &kp END
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |   F1  |   F2  |   F3  |   F4  |   F5  |                   | BT_CLR|       |       |       |       |  DEL  |
            // |       |   F6  |   F7  |   F8  |   F9  |  F10  |                   |   +   |       |   ^   |       |       |       |
            // |       |  F11  |  F12  |       |       |       |                   |   -   |   <-  |   v   |   ->  |       |       |
            // |  CTRL |       |       |       |       |       |       |   |>ARTIST|       |       |       |       |       |       |
            //                         |  GUI  |       |  ALT  |       |   |       |       |       |       |

            display-name = "Raise";
            bindings = <
&none      &kp F1   &kp F2   &kp F3    &kp F4  &kp F5                  &bt BT_CLR  &none     &none     &none      &none  &kp DEL
&none      &kp F6   &kp F7   &kp F8    &kp F9  &kp F10                 &kp PLUS    &none     &kp UP    &none      &none  &none
&none      &kp F11  &kp F12  &none     &none   &none                   &kp MINUS   &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none
&kp LCTRL  &none    &none    &none     &none   &none     &none  &to 3  &none       &none     &none     &none      &none  &none
                             &kp LGUI  &none   &kp LALT  &none  &none  &none       &none     &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        artist_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |       |       |       |       |       |                   |       |       |       |       |       |       |
            // | S+CTRL|       |       |       |       |       |                   |       |       |       |       |       |       |
            // | SHIFT |       |       |       |       |       |                   |       |       |       |       |       |       |
            // |       |  UNDO |       |       |       |       |  REDO |   | >GAME |       |       |       |       |       |       |
            //                         |       |       |  ALT  | SPACE |   |       |       |       |       |

            display-name = "Artist";
            bindings = <
&trans         &kp trans  &trans  &trans  &trans  &trans                           &trans  &trans  &trans  &trans  &trans  &trans
&kp LS(LCTRL)  &kp trans  &trans  &trans  &trans  &trans                           &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHFT      &trans     &trans  &trans  &trans  &trans                           &trans  &trans  &trans  &trans  &trans  &trans
&trans         &kp LC(Z)  &trans  &trans  &trans  &trans    &kp LS(LC(Z))  &to 4   &trans  &trans  &trans  &trans  &trans  &trans
                                  &trans  &trans  &kp LALT  &kp SPACE      &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        game_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |       |       |       |       |       |                   |       |       |       |       |       |       |
            // |  TAB  |       |       |       |       |       |                   |       |       |       |       |       |       |
            // | SHIFT |       |       |       |       |       |                   |       |       |       |       |       |       |
            // |       |       |       |       |       |       |       |   | >BASE |       |       |       |       |       |       |
            //                         |       |       |  RALT | SPACE |   |       |       |       |       |

            display-name = "Game";
            bindings = <
&trans     &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB    &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans    &trans     &to 5   &trans  &trans  &trans  &trans  &trans  &trans
                           &trans  &trans  &kp RALT  &kp SPACE  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        colemak_dh {
            // ------------------------------------------------------------------------------------------------------------
            // |       |       |       |       |       |       |                   |       |       |       |       |       |       |
            // |       |   Q   |   W   |   F   |   P   |   B   |                   |   J   |   L   |   U   |   Y   |   ;   |       |
            // |       |   A   |   R   |   S   |   T   |   G   |                   |   M   |   N   |   E   |   I   |   O   |       |
            // |       |   Z   |   X   |   C   |   D   |   V   |       |   | >BASE |   K   |   H   |   ,   |   .   |   /   |       |
            //                         |       |       |       |       |   |       |       |       |       |

            display-name = "colemak";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans     &trans   &trans    &trans
&trans  &kp Q   &kp W   &kp F   &kp P   &kp B                   &kp J   &kp L   &kp U      &kp Y    &kp SEMI  &trans
&trans  &kp A   &kp R   &kp S   &kp T   &kp G                   &kp M   &kp N   &kp E      &kp I    &kp O     &trans
&trans  &kp Z   &kp X   &kp C   &kp D   &kp V   &trans  &to 0   &kp K   &kp H   &kp COMMA  &kp DOT  &kp FSLH  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_3 { status = "reserved"; };
    };


};
